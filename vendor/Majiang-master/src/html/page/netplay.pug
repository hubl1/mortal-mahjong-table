- var page = 'netplay'

doctype html
html(lang="zh-CN")
  
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=800, initial-scale=1, minimum-scale=1, maximum-scale=1, user-scalable=no")

    include ../inc/ogp
    +ogp('Mortal麻将', 'WebSocketで動作する麻雀サーバー', 
          'https://kobalab.net/majiang/img/netplay.png')

    include ../inc/style
    script(src="server/socket.io/socket.io.js" defer)
    include ../inc/script
  
  body.title
    include ../inc/loaderr
    include ../inc/navi
    include ../inc/title
    include ../inc/loaddata

    include ../inc/file
    include ../inc/stat
    include ../inc/room
    include ../inc/board
    .version ver. #{version}
